# ==============================================================
# Adaptive Multi-LLM Router — Backend Environment Configuration
# ==============================================================
# Copy this file to .env and fill in the values you need.
# NEVER commit the actual .env file.

# --- Application ---
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=info

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# --- Request limits ---
MAX_PROMPT_LENGTH=32000
REQUEST_TIMEOUT_SECONDS=120

# --- Provider API Keys (server-side only) ---
# Only configure the providers you intend to use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Ollama (local models) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Jev Decision Layer (experimental) ---
# JEV_API_KEY=
# JEV_BASE_URL=

# --- Database (Phase 8+) ---
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/llm_router

# --- Redis (Phase 8+) ---
# REDIS_URL=redis://localhost:6379/0
